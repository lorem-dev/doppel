# Rust
/target
**/*.rs.bk
*.pdb

# Runtime artifacts. Anchored with a leading slash, all of them: `config/`
# without one matches a directory of that name at any depth, which quietly
# covered `crates/doppel-core/src/config/` -- git keeps tracking files it
# already knows, so nothing failed, but every editor drew the crate's own
# configuration module as excluded.
/templates
*.sock
/main.yaml
# The configuration the compose file mounts, and anything else kept beside it.
/config/
.env

# mkdocs build output
/site

# Staged into the docs tree from assets/ by scripts/mkdocs_assets.py on every
# build. Committing the copy would be two files claiming to be the same icon.
/docs/assets

# Frontend build and tooling output. `dist` is what the admin crate's build
# script embeds, so it is generated on the way to a binary and never committed;
# `public/favicon.ico` is copied in from assets/ by the prebuild script.
/frontend/node_modules
/frontend/dist
/frontend/coverage
/frontend/playwright-report
/frontend/test-results
/frontend/public/favicon.ico

# Python tooling for mkdocs
.venv
__pycache__/

# Agent workspaces, not shipped
.superpowers
.worktrees

# Editors and OS
.DS_Store
.idea/
.vscode/

# Local notes
TODO*

# Composed by scripts/release_notes.py during a release and consumed by
# `gh release create`. A build artifact, not something the repository keeps.
/RELEASE_NOTES.md

# Where the release workflow stages archives before publishing them.
/dist
